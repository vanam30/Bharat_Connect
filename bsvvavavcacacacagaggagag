import { http } from './http';

// Only batches the current authorizer can still act on (server filters out self-acted) [web:312]
export async function getAuthorizerInbox(page = 0, size = 20) {
  const { data } = await http.get('/api/payroll/batch/authorizer/inbox', { params: { page, size } }); // [web:312]
  return data;
}

// Approve one step (server increments approvalsDone, derives status) [web:312]
export async function approveBatch(batchId, remarks) {
  const { data } = await http.patch(`/api/payroll/batch/${encodeURIComponent(batchId)}/status`, null, {
    params: { action: 'APPROVE', remarks }
  }); // [web:312]
  return data;
}

// Reject terminally (server sets rejected) [web:312]
export async function rejectBatch(batchId, remarks) {
  const { data } = await http.patch(`/api/payroll/batch/${encodeURIComponent(batchId)}/status`, null, {
    params: { action: 'REJECT', remarks }
  }); // [web:312]
  return data;
}




